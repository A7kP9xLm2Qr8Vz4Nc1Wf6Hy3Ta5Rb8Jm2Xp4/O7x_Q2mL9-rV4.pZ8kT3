function t:SelectTab(do_)
	self.selectedIndex = do_
	for dp, dq in ipairs(self.tabs) do
		dq.Page.Visible = (dp == do_)
		if dp == do_ then
			a:Create(dq.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = e.accentSelected,
				TextColor3 = e.textPrimary
			}):Play()
		else
			a:Create(dq.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = e.textSecondary
			}):Play()
		end
	end
