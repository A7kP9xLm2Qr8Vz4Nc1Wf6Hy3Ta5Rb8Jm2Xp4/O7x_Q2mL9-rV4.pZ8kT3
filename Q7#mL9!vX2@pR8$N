		if selectedStatsPlayer then updateStats(selectedStatsPlayer) end
		task.wait(0.01)
	end
end)
local enemyHealthLabel = statsTab:AddSectionLabel("Enemy Health: N/A")
local enemyDamageLabel = statsTab:AddSectionLabel("Enemy Damage: N/A")
local yourHealthLabel = statsTab:AddSectionLabel("Your Health: N/A")
local yourDamageLabel = statsTab:AddSectionLabel("Your Damage: N/A")
local hitsLabel = statsTab:AddSectionLabel("Hits To Kill: N/A")
local function getHealth(plr)
	if not plr then return 0 end
	local dur = plr:FindFirstChild("Durability") or (plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Durability"))
	if not dur then return 0 end
	local mult = 1
	if plr:FindFirstChild("ultimatesFolder") and plr.ultimatesFolder:FindFirstChild("Infernal Health") then
		mult = mult + 0.15 * (plr.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if plr:FindFirstChild("equippedPets") then
		for _, pet in ipairs(plr.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local n = string.lower(pet.Value.Name)
				if n:match("mighty") and n:match("monster") then mult = mult + 0.5 end
				if n:match("small") and n:match("fry") then mult = mult + 0.25 end
			end
		end
	end
	return dur.Value * mult
end
local function getDamage(plr)
	if not plr or not plr:FindFirstChild("leaderstats") or not plr.leaderstats:FindFirstChild("Strength") then return 0 end
	local base = plr.leaderstats.Strength.Value * (1/15)
	local mult = 1
	if plr:FindFirstChild("ultimatesFolder") and plr.ultimatesFolder:FindFirstChild("Demon Damage") then
		mult = mult + 0.1 * (plr.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if plr:FindFirstChild("equippedPets") then
		for _, pet in ipairs(plr.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local n = string.lower(pet.Value.Name)
				if n:match("wild") and n:match("wizard") then mult = mult + 0.5 end
				if n:match("chaos") and n:match("sorcerer") then mult = mult + 0.25 end
			end
		end
	end
	return base * mult
end
local function updateCombat(plr)
	if not plr then
		enemyHealthLabel.Text = "Enemy Health: N/A"
		enemyDamageLabel.Text = "Enemy Damage: N/A"
		yourHealthLabel.Text = "Your Health: N/A"
		yourDamageLabel.Text = "Your Damage: N/A"
		hitsLabel.Text = "Hits To Kill: N/A"
		return
	end
	local eHealth = getHealth(plr)
	local eDamage = getDamage(plr)
	local yHealth = getHealth(LocalPlayer)
	local yDamage = getDamage(LocalPlayer)
	local hits = "∞"
	if yDamage > 0 then
		local h = math.ceil(eHealth / yDamage)
		if h > 200 then hits = "∞"
		elseif h < 1 then hits = "instant"
		else hits = tostring(h) end
	end
	enemyHealthLabel.Text = string.format("Enemy Health: %s (%s)", formatShort(eHealth), formatCommas(eHealth))
	enemyDamageLabel.Text = string.format("Enemy Damage: %s (%s)", formatShort(eDamage), formatCommas(eDamage))
	yourHealthLabel.Text = string.format("Your Health: %s (%s)", formatShort(yHealth), formatCommas(yHealth))
	yourDamageLabel.Text = string.format("Your Damage: %s (%s)", formatShort(yDamage), formatCommas(yDamage))
	hitsLabel.Text = "Hits To Kill: " .. hits
end
