local nameLabel = statsTab:AddSectionLabel("Name: N/A")
local strengthLabel = statsTab:AddSectionLabel("Strength: N/A")
local durabilityLabel = statsTab:AddSectionLabel("Durability: N/A")
local function updateStats(plr)
	if not plr then return end
	nameLabel.Text = "Name: " .. plr.DisplayName
	if not plr:FindFirstChild("leaderstats") then return end
	local function setStat(label, name, key)
		local val = plr.leaderstats:FindFirstChild(key) or plr:FindFirstChild(key)
		if val then
			label.Text = string.format("%s: %s (%s)", name, formatShort(val.Value), formatCommas(val.Value))
		else
			label.Text = name .. ": 0 (0)"
		end
	end
	setStat(strengthLabel, "Strength", "Strength")
	setStat(durabilityLabel, "Durability", "Durability")
end
task.spawn(function()
