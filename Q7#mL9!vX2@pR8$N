local antiFling = false
local humanoid  = nil
local function applyAntiFling()
	if not antiFling or not LocalPlayer.Character then return end
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local existing = hrp:FindFirstChild("BodyVelocity")
	if existing and existing.MaxForce == Vector3.new(100000, 0, 100000) then
		existing:Destroy()
	end
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(100000, 0, 100000)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.P = 1250
	bv.Parent = hrp
end
local function removeAntiFling()
	if not LocalPlayer.Character then return end
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local existing = hrp:FindFirstChild("BodyVelocity")
	if existing and existing.MaxForce == Vector3.new(100000, 0, 100000) then
		existing:Destroy()
	end
end
mainTab:AddToggle("Anti Fling", function(state)
	antiFling = state
	if state then applyAntiFling() else removeAntiFling() end
end)
